    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\n\nconst flights = items\n  .filter(item => item.flight_id !== undefined)\n  .slice(0, 5);\n\nconst hotels = items\n  .filter(item => item.hotel_id !== undefined)\n  .slice(0, 5);\n\nconst attractions = items\n  .filter(item => item.attraction_name !== undefined)\n  .slice(0, 5);\n\nlet weather = [];\n\nfor (const item of items) {\n  if (Array.isArray(item.weather)) {\n    weather.push(...item.weather);\n  }\n\n  if (item.temperature !== undefined) {\n    weather.push({\n      destination: item.destination,\n      temperature: item.temperature,\n      rainfall: item.rainfall,\n      humidity: item.humidity\n    });\n  }\n}\n\nweather = weather.slice(0, 5);\n\nconst budget = items.find(item => item.total_budget !== undefined);\n\nreturn [{\n  json: {\n    flights,\n    hotels,\n    weather,\n    budget: budget || {},\n    attractions\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
