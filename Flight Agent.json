    {
      "parameters": {
        "jsCode": "const flights = $input.all().map(item => item.json);\n\nconst input = $('When Executed by Another Workflow').first().json;\n\nconst destination = String(input.destination || '')\n  .trim()\n  .toLowerCase();\n\nconst sortBy = String(input.sort_by || '')\n  .trim()\n  .toLowerCase();\n\nif (!destination) {\n  return [{\n    json: {\n      error: \"Destination was not provided\"\n    }\n  }];\n}\n\nconst matches = flights.filter(f => {\n  const flightDestination = String(f.destination || '')\n    .trim()\n    .toLowerCase();\n\n  return flightDestination === destination;\n});\n\nif (sortBy === \"price\") {\n  matches.sort((a, b) =>\n    Number(a.price) - Number(b.price)\n  );\n}\n\nif (sortBy === \"duration\" || sortBy === \"duration_minutes\") {\n  matches.sort((a, b) =>\n    Number(a.duration_minutes) - Number(b.duration_minutes)\n  );\n}\n\nreturn matches.slice(0, 5).map(f => ({\n  json: f\n}));"
      },
