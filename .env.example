# ==============================================================================
# Multi-Agent AI Vacation Planner - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.

# Google Gemini API Key (Required for LLM Request Parsing, Itinerary Generation, and Critic)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ElevenLabs API Key (Required for Text-to-Speech Voice Narration)
# Obtain from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Supabase Credentials (Required for Flights, Hotels, Weather, Attractions, Memory, pgvector RAG)
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# n8n Orchestrator Webhook URL (Optional: Leave empty to use built-in robust local agent orchestrator)
# Example: http://localhost:5678/webhook/planner-agent
N8N_WEBHOOK_URL=

# Application Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
