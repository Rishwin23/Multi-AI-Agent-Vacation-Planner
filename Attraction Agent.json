        "jsCode": "const input = $('When Executed by Another Workflow').first().json;\n\nconst destination = String(input.destination || '')\n  .trim()\n  .toLowerCase();\n\nconst attractions = $input.all().map(item => item.json);\n\nconst matches = attractions.filter(a => {\n  const city = String(a.destination || '')\n    .trim()\n    .toLowerCase();\n\n  return city === destination;\n});\n\nreturn matches.slice(0, 5).map(a => ({\n  json: {\n    attraction_name: a.attraction_name,\n    entry_fee: a.entry_fee,\n    destination: a.destination,\n    timings: a.timings,\n    category: a.category\n  }\n}));"
