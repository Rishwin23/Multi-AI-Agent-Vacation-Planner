      "parameters": {
        "jsCode": "const input = $('When Executed by Another Workflow').first().json;\n\nconst city = String(input.city || '').trim().toLowerCase();\nconst budget = Number(input.budget || 0);\nconst minRating = Number(input.min_rating || 0);\n\nconst hotels = $input.all().map(item => item.json);\n\nconst filtered = hotels\n  .filter(h => {\n    const hotelCity = String(h.city || '').trim().toLowerCase();\n    const hotelCost = Number(h.cost);\n    const hotelRating = Number(h.rating);\n\n    return (\n      hotelCity === city &&\n      hotelCost <= budget &&\n      hotelRating >= minRating\n    );\n  })\n  .sort((a, b) => Number(b.rating) - Number(a.rating))\n  .slice(0, 5);\n\nreturn filtered.map(h => ({\n  json: {\n    hotel_id: h.hotel_id,\n    hotel_name: h.hotel_name,\n    city: h.city,\n    rating: h.rating,\n    cost: h.cost,\n    facilities: h.facilities\n  }\n}));"
      },
